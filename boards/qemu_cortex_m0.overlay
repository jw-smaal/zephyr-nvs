/* Remove the default 8 KB storage_partition (0x0003e000 .. 0x00040000) */
/delete-node/ &storage_partition;

&flash0 {
	partitions {
		/* First 4 KB (4 pages of 1024 B): system storage partition */
		storage_partition: partition@3e000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x0003e000 0x00001000>;
		};

		/* Second 4 KB (4 pages of 1024 B): extra custom NVRAM partition */
		user_nvram_partition: partition@3f000 {
			compatible = "zephyr,mapped-partition";
			label = "user-nvram";
			reg = <0x0003f000 0x00001000>;
		};
	};
};
